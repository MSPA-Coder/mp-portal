# Modelo do `.env.docker` lido pelo Compose. Copie, ajuste e NAO versione o
# resultado -- o `.gitignore` ja recusa `.env*` fora deste exemplo.
#
# Os SEGREDOS nao ficam aqui: `django_secret_key` e `postgres_password` sao
# arquivos em `.secrets/`, montados pelo Compose como segredo. Este arquivo
# guarda apenas configuracao.

# Portas publicadas em 127.0.0.1 (numeracao da frota: megasena 51xx, bancario
# 52xx, renda/conforto 50xx, site 55xx, portal 56xx).
APP_PORT=5601
POSTGRES_PORT=5602

POSTGRES_DB=mp_portal
POSTGRES_USER=mp_portal

# Nunca ligue DEBUG numa instalacao alcancavel por outra pessoa.
DEBUG=False

# Ligue junto com um proxy TLS a frente. Com USE_HTTPS=True, a aplicacao exige
# CSRF_TRUSTED_ORIGINS, CONTATO_CANAL_TITULAR e CONTATO_ORIGENS_PERMITIDAS --
# e recusa subir sem eles.
USE_HTTPS=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Origens autorizadas a enviar POST /contato: esquema e host, sem barra final,
# separadas por virgula. Vazio recusa tudo (fora do modo de depuracao).
# Exemplo, quando o site estiver apontado para ca:
#   CONTATO_ORIGENS_PERMITIDAS=https://mp-solucoes.duckdns.org
CONTATO_ORIGENS_PERMITIDAS=

# Redes das quais `X-Forwarded-For` pode ser acreditado (a rede do nginx
# central, no VPS). Vazio usa somente REMOTE_ADDR.
CONTATO_PROXIES_CONFIAVEIS=

# Endereco publicado no aviso de privacidade para o titular exercer os direitos
# do art. 18 da LGPD.
CONTATO_CANAL_TITULAR=

# Prazo de retencao em dias. O aviso de privacidade mostra este numero, e
# `manage.py expurgar_contatos` o aplica.
CONTATO_RETENCAO_DIAS=730
