# Modelo do `.env.vps` que o `deploy.sh` da frota lê no servidor
# (`docker compose --env-file .env.vps`). Copie para `.env.vps`, ajuste e NAO
# versione o resultado -- o `.gitignore` recusa `.env*` fora dos exemplos.
#
# Os SEGREDOS nao ficam aqui: `django_secret_key` e `postgres_password` sao
# arquivos em `.secrets/`, e `.certs/local-root-ca.crt` e o CA de build. Todos
# criados a mao no servidor, uma vez. Ver `docs/operacao.md`.

# Numeracao da frota: megasena 51xx, bancario 52xx, renda/conforto 50xx,
# portal 56xx. Publicado so em 127.0.0.1 -- quem expoe e o nginx central.
APP_PORT=5601
POSTGRES_PORT=5602

POSTGRES_DB=mp_portal
POSTGRES_USER=mp_portal

DEBUG=False

# Producao fica atras do nginx central com TLS. Com USE_HTTPS=True a aplicacao
# RECUSA subir sem CSRF_TRUSTED_ORIGINS e CONTATO_CANAL_TITULAR -- e deliberado.
USE_HTTPS=True
# O dominio publico e mais `localhost,127.0.0.1`: o healthcheck do Compose bate
# em `http://127.0.0.1:8000/health`, e sem esses dois o Django responde 400 e o
# contêiner nunca fica `healthy`.
ALLOWED_HOSTS=mp-solucoes.duckdns.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://mp-solucoes.duckdns.org

# Rede do nginx central, para acreditar no X-Forwarded-For. Sem isto o limite
# de envios conta todo o trafego como vindo de um IP so.
CONTATO_PROXIES_CONFIAVEIS=172.16.0.0/12

# Endereco publicado no aviso de privacidade para o titular exercer os direitos
# do art. 18 da LGPD. Um alias encaminhado resolve sem custo.
CONTATO_CANAL_TITULAR=privacidade@mp-solucoes.duckdns.org

CONTATO_RETENCAO_DIAS=730
